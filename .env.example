# --- database ---
POSTGRES_USER=peach
POSTGRES_PASSWORD=peach
POSTGRES_DB=peach
POSTGRES_PORT=5432

# --- backend ---
DATABASE_URL=postgresql+asyncpg://peach:peach@db:5432/peach
BACKEND_PORT=8000
APP_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000

# --- frontend ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_URL=http://backend:8000

# --- aws (make deploy-backend / deploy-frontend / domain) ---
# Everything lands in us-east-1, tagged PROJECT_NAME=<PROJECT_NAME>. Every
# other knob has a default in the scripts or templates and can still be set
# here to override it.
AWS_REGION=us-east-1
PROJECT_NAME=peach
# Blank keys fall back to AWS_PROFILE, SSO, or an instance role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_PROFILE=

# The deployed frontend's origin, once it has one.
API_CORS_ORIGINS=*

# --- google sign-in (make deploy-cognito) ---
# An OAuth client from Google Cloud. Leave blank for email + password only;
# fill in and re-run make deploy-cognito to add Google. Its authorised
# redirect URI is printed by the deploy.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- written by the scripts, not by hand ---
# make deploy-cognito: the user pool the backend and frontend sign in against.
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
COGNITO_GOOGLE_ENABLED=false
# make deploy-backend: the function URL. make deploy-frontend builds against it.
BACKEND_URL=
# make domain DOMAIN=app.example.com: the frontend's custom domain.
DOMAIN_NAME=

# --- reports (make deploy-reports) ---
REPORT_IMAGE_URI=
REPORT_SENDER=
REPORT_RECIPIENTS=
# Optional owned domain; add the stack's DKIM CNAME outputs to DNS.
REPORT_SENDER_DOMAIN=

# API report button (existing private reports bucket; empty disables requests)
REPORTS_BUCKET=
# Optional comma-separated addresses enabled for report requests in SES sandbox
REPORT_REQUEST_RECIPIENTS=

# --- agenda parser (AI disabled until model billing is explicitly approved) ---
PARSER_ENABLED=false
PARSER_MODEL=anthropic.claude-opus-5-5
PARSER_INPUT_PRICE=4.4
PARSER_OUTPUT_PRICE=22
AI_IMAGE_URI=
AI_BUDGET_EMAIL=
AGENDA_PARSER_URL=
NEXT_PUBLIC_AGENDA_PARSER_URL=
NEXT_PUBLIC_AGENDA_PARSER_ENABLED=false

# Optional free cloud alternative; never use NEXT_PUBLIC_ for the secret key.
# Use make free-ai-server / free-ai-frontend; existing AWS AI stays disabled.
PARSER_PROVIDER=bedrock
OPENROUTER_API_KEY=
